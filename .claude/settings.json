{
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm run typecheck)",
      "Bash(npm audit)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(~/.gnupg/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "sandbox": {
    "enabled": true
  }
}
